[Unit]
Description=Raspberry Pi Dashcam Service
After=network.target local-fs.target
Wants=network-online.target
StartLimitIntervalSec=30s
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/opt/dashcam
ExecStart=/usr/bin/python3 /opt/dashcam/app/main.py
Restart=always
RestartSec=5s
StandardOutput=append:/var/log/dashcam/dashcam.log
StandardError=inherit
TimeoutStopSec=20s

[Install]
WantedBy=multi-user.target
